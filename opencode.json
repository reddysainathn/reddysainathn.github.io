{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git": "allow",
      "git *": "allow",
      "npm": "allow",
      "npm *": "allow",
      "npx": "allow",
      "npx *": "allow",
      "node": "allow",
      "node *": "allow",
      "gh": "allow",
      "gh *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "head": "allow",
      "head *": "allow",
      "echo": "allow",
      "grep": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "uniq": "allow",
      "uniq *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "comm *": "allow",
      "diff *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "jq *": "allow",
      "printf *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "hostname": "allow",
      "whoami": "allow",
      "df": "allow",
      "df *": "allow",
      "du": "allow",
      "du *": "allow",
      "git push*--force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -d*": "deny",
      "git branch -D*": "deny"
    }
  }
}
