{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git": "allow",
      "git *": "allow",
      "npm": "allow",
      "npm *": "allow",
      "npx": "allow",
      "npx *": "allow",
      "node": "allow",
      "node *": "allow",
      "gh": "allow",
      "gh *": "allow",
      "git push*--force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -d*": "deny",
      "git branch -D*": "deny"
    }
  }
}
