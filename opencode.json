{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git": "allow",
      "git *": "allow",
      "npm": "allow",
      "npm *": "allow",
      "npx": "allow",
      "npx *": "allow",
      "git push*--force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -d*": "deny",
      "git branch -D*": "deny"
    }
  }
}
