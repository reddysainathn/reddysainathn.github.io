{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://reddysainathn.github.io",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.ssr.config.mjs && node tools/snapshot.mjs",
    "build_legacy": "vite build && cp dist/index.html dist/404.html",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "git config core.hooksPath tools/git-hooks",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.8",
    "vite": "8.3.0"
  }
}
